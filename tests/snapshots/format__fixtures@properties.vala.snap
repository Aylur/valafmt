public class Prop : Object {
    public int simple { get; set; }
    public string name { get; private set; default = "unnamed"; }
    public owned string owned_prop { owned get; set construct; }
    public int computed {
        get {
            return backing * 2;
        }
        set {
            backing = value / 2;
        }
    }
    public bool flag { get; construct set; default = true; }
}

public class Inline : Object {
    internal List<weak Notification> notifications {
        get { return notification_list; }
    }
    internal string broken_source {
        get {
            return name;
        }
    }
    public int both {
        get { return a; }
        set { a = value; }
    }
    public int mixed {
        get { return a; }
        set {
            a = value;
            notify();
        }
    }
    public int expanded {
        get {
            return a;
        }
    }
}

public class BothRule : Object {
    public int both_inline_source {
        get { return a; }
        set { a = value; }
    }
    public int single_stays { get { return a; } }
    public int bodyless_stays { get; set; }
    public int body_and_default {
        get { return a; }
        default = 1;
    }
}
